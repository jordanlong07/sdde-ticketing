<div class='flex flex-col gap-3 lg:items-center lg:self-center lg:w-fit lg:mx-auto'>

  <h1 class='text-center font-underline text-3xl '>Log in</h1>
  <div class='bg-slate-100 px-12 py-6 shadow border rounded-md'>

    <%= form_for(resource, as: resource_name, data: {turbo: false}, url: session_path(resource_name)) do |f| %>
    <div class='flex flex-col gap-10 lg:gap-3'>
      <div class="field">
        <%= f.label :email, class: 'text-xl' %><br />
        <%= f.email_field :email, autofocus: true, autocomplete: "email", class: 'text-xl' %>
      </div>


      <div class="field">
        <%= f.label :password, class: 'text-xl' %><br />
        <%= f.password_field :password, autocomplete: "current-password", class: 'text-xl' %>
      </div>

      <% if devise_mapping.rememberable? %>
        <div class="field">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me, class: 'text-xl' %>
        </div>
      <% end %>

      <div class="actions">
        <%= f.submit "Log in", class: 'border rounded py-3 text-2xl text-center bg-slate-400 mb-12 w-full cursor-pointer' %>
      </div>
    </div>

    <% end %>

  <%= render "devise/shared/links" %>
  </div>
</div>