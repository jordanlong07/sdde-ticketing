.place-self-end.border-2.rounded.px-4.py-6.bg-slate-100.h-full.flex.flex-col
    - @comments = Comment.where(ticket_id: ticket.id)
    - if @comments.present?
        .comment-section
            h3 Comments (#{@comments.length})
            .flex.flex-col.gap-2.mt-3.overflow-y-auto.comments
                - @comments.each do |comment|
                    - if comment.author == current_user.id
                        = render 'comment/your_comment', comment: comment
                    - else
                        = render 'comment/other_comment', comment: comment
    - else
        .comment-section
            h3.text-lg.text-center.underline No comments yet

    = render 'comment/comment_box', ticket: @ticket