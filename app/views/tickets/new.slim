= form_with model: @ticket, class: 'lg:w-full', data: {turbo: false}, url: tickets_path do |f|
    .flex.flex-col.gap-3.px-6.py-6.drop-shadow class='lg:w-1/2 lg:mx-auto lg:bg-slate-300 lg:border lg:rounded-md.'
        h1 class='text-4xl text-center' New Ticket
        .flex.flex-col.gap-3
            = f.label :title, class: 'text-xl'
            = f.text_field :title, class: 'border-2 border-slate-500 rounded-md px-2 py-1 text-2xl', required: :true
        .flex.flex-col.gap-3
            = f.label :ticket_description, class: 'text-xl'
            = f.text_area :ticket_description, class: 'border-2 border-slate-500 rounded-md px-2 py-1 h-40'
        .flex.flex-col.gap-3
            = f.label :due_date, class: 'text-xl'
            = f.date_field :due_date, class: 'border-2 border-slate-500 rounded-md px-2 py-1 text-2xl'
        .flex.flex-col.gap-3
            = f.label :priority, class: 'text-xl'
            = f.select :priority, ['Low', 'Medium', 'High'], class: 'border-2 border-slate-500 rounded-md px-2 py-1 text-2xl'
        
        .flex.flex-col.gap-3
            = f.label :assigned_to, class: 'text-xl'
            = f.collection_select :assigned_to, User.all, :id, :user_name, class: 'border-2 border-slate-500 rounded-md px-2 py-1 text-2xl'

        .hidden.items-center class='lg:flex'
            = f.label :assigned_by, class: 'text-xl'
            = f.text_field :assigned_by, class: 'bg-slate-300 border-none text-xl w-fit text-center lg:text-left', value: current_user.user_name, readonly: true

        = f.submit 'Create Ticket', class: 'bg-slate-500 text-white rounded-md px-2 py-1 text-2xl w-full lg:w-1/2 mx-auto place-self-center lg:hover:bg-slate-600 lg:cursor-pointer'


