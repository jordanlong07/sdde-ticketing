= form_with model: @ticket, url: ticket_path(@ticket), method: :patch, class: 'w-full', data: {turbo: false}do |form|
    .rounded-md.flex.flex-row.w-full.justify-between.drop-shadow
        .flex.flex-col.gap-8.bg-slate-50.w-full.px-6.py-4.border-t.border-b.border-l.rounded-md
            p.text-3xl = @ticket.title
            = form.text_area :ticket_description, class: 'w-full border-none focus:outline-none resize-none outline-none', rows: 10
            .inline-flex.gap-1.bg-slate-100.p-2.rounded
                p Ticket Created:
                p = @ticket.created_at.strftime('%B %d, %Y')
            .flex.gap-3.w-full
                .flex.flex-col.gap-1.p-2.rounded class = "#{@due_date_expired  ? 'bg-red-100' : 'bg-slate-100'} w-1/2"
                    p Ticket Due:
                    = form.date_field :due_date, value: @ticket.due_date
                .bg-slate-100.p-2 class='w-1/2'
                    p Ticket Status
                    = form.select :status, options_for_select([['Open', 'Open'], ['Closed', 'Closed'], ['In Progress', 'In Progress'], ['On Hold', 'On Hold']], selected: @ticket.status), class: ''
            .flex.gap-2.w-full
                .flex.flex-col.gap-2.bg-slate-100.p-2.rounded class='w-1/2'
                    p Ticket Priority
                    = form.select :priority, options_for_select([['Low', 'Low'], ['Medium', 'Medium'], ['High', 'High']], selected: @ticket.priority)
                .flex.flex-col.gap-2.bg-slate-100.p-2 class='w-1/2'
                    p Assigned To
                    = form.collection_select :assigned_to, User.all, :id, :user_name, selected: @ticket.assigned_to, class: 'w-fit px-2'
            = form.submit 'Update Ticket', class: 'border rounded-md p-2 bg-slate-100 hover:bg-slate-200 self-center cursor-pointer'
    