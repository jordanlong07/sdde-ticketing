<!DOCTYPE html>
<html>
  <head>
    <title>SddeTicketing</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "inter-font", "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <script src="https://kit.fontawesome.com/814e96607e.js" crossorigin="anonymous"></script>
  </head>

  <body>
  <div class='hidden lg:block'>
  <h1 class='text-center text-3xl p-3 underline border-b'>BT's ticketing system</h1>
    <%= render "components/navbar" %>
</div>
    <main class="container mx-auto lg:mt-18 mt-12 px-5 flex">
      <%= yield %>
    </main>
  </body>
</html>
